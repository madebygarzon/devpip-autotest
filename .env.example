DEEPSEEK_API_KEY=*************************

# Database Configuration
# Direct connection to the database
DATABASE_URL="postgres://***************:5432/postgres?sslmode=require"

# Accelerate connection (for Prisma Accelerate - optional but recommended for better performance)
PRISMA_DATABASE_URL="prisma+postgres://a*******************"

# Alternative direct PostgreSQL URL (same as DATABASE_URL, kept for compatibility)
POSTGRES_URL="*************************"

CLARITY_PROJECT_ID="***********"

CLARITY_TOKEN="************"

# API Strategy: 'minimal' (2 calls), 'balanced' (3 calls), or 'full' (5 calls)
CLARITY_API_STRATEGY=minimal
NEXT_PUBLIC_CLARITY_API_STRATEGY=minimal
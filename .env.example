DEEPSEEK_API_KEY=

# Microsoft Clarity Data Export API
# Get your API token from: Clarity Project > Settings > Data Export > Generate new API token
CLARITY_TOKEN=your_clarity_api_token_here
CLARITY_PROJECT_ID=your_project_id_here

# Clarity API Strategy (optional - defaults to 'minimal')
# Options:
#   - minimal: 2 API calls/day (KPIs + Device/Browser/OS + Top Pages)
#   - balanced: 3 API calls/day (+ Country/Source/Channel)
#   - full: 5 API calls/day (all dimensions separately for max detail)
CLARITY_API_STRATEGY=minimal
